# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/

# Compiled output that landed in a package's src/ instead of dist/, from a
# tsc run against a config without outDir. Each package's `main` points at
# dist/, so these are unreachable dead weight that would shadow the .ts
# sources in any resolver that prefers .js.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
!packages/*/src/**/*.d.ts.ts

# Environment
.env
.env.local
.env.*.local
# Backups and shadow copies of env files hold real credentials; only commit
# .env.example. Without this, a `cp .env .env.bak` leaks secrets into git.
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Logs
*.log

# Test coverage
coverage/

# Solana
programs/braice-governance/target/
programs/braice-governance/.anchor/
# `solana-test-validator --reset --bpf-program ...` writes a full ledger here
# (rocksdb, genesis, snapshots, ~360 MB). It is a disposable local validator
# state directory that happened to be committed, along with its faucet/validator/
# vote/stake keypairs — localnet-only keys, so nothing secret leaks, but it makes
# the repo enormous and it is not reproducible state worth keeping. Delete the
# directory freely; recreating it is one command.
programs/braice-governance/test-ledger/
# The same ledger when the validator is started from the repo root rather than
# the program directory — `solana-test-validator` writes into whatever directory
# it is launched in, so the root collects its own copy of the same ~600 MB.
/test-ledger/
# The Anchor workspace carries a package.json only so its integration test can
# resolve @braice/blockchain-client and web3.js. The Rust builds with cargo, so
# the dependency tree belongs in pnpm's store, not in git.
programs/*/node_modules/
