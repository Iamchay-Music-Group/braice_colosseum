{
  "name": "@braice/api",
  "version": "0.1.0",
  "private": true,
  "description": "BRAICE API - NestJS Backend",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "db:migrate": "ts-node src/scripts/migrate.ts",
    "db:seed": "ts-node src/scripts/seed.ts",
    "seed:demo": "ts-node ../../scripts/seed-demo.ts",
    "demo": "bash ../../scripts/demo-walkthrough.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@braice/ai-client": "workspace:*",
    "@braice/blockchain-client": "workspace:*",
    "@braice/permission-engine": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "@solana/web3.js": "^1.95.3",
    "bs58": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "pg": "^8.11.0",
    "swagger-ui-express": "^5.0.0",
    "tweetnacl": "^1.0.3",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bs58": "^4.0.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.5.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  }
}
