{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@braice/types": ["packages/types/src"],
      "@braice/permission-engine": ["packages/permission-engine/src"],
      "@braice/governance-engine": ["packages/governance-engine/src"],
      "@braice/blockchain-client": ["packages/blockchain-client/src"],
      "@braice/ai-client": ["packages/ai-client/src"]
    }
  }
}
