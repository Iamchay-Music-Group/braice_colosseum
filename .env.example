NODE_ENV=development
# Must match NEXT_PUBLIC_API_URL in ../braice_colosseum_fend/.env.local.
# 3003 is chosen because 3001 is often taken by other local tooling.
PORT=3003

DATABASE_URL=postgresql://braice:braice_secret@localhost:5433/braice_db

# --- Account authentication (email + password) ---
# REQUIRED. Generate with: openssl rand -base64 48
# The API refuses to boot without a >= 32 character value.
JWT_SECRET=
# Access token lifetime in seconds (default 900 = 15 min)
JWT_TTL_SECONDS=900

# Concurrent failed logins before the account is locked.
PASSWORD_MAX_ATTEMPTS=10
# How long the lockout lasts, in seconds (default 900 = 15 min).
PASSWORD_LOCKOUT_SECONDS=900
# scrypt CPU cost as a power of two: 15 => N = 32768 (~32 MB per hash).
# Must be 13..18. Raise it to harden stored passwords; existing hashes are
# re-hashed at the new cost the next time each user signs in.
PASSWORD_SCRYPT_COST=15

# --- Solana ---
# A wallet is an OPTIONAL account attribute used only as the on-chain grantee
# pubkey when a governance grant is anchored. It is never a credential.
#
# Set to true to also allow signing in with a wallet, for accounts that have
# linked one. Off by default: email + password is the product's only real
# sign-in. Unrecognised values (e.g. "yes") are treated as false.
WALLET_AUTH_ENABLED=false
# Sign-in nonce lifetime in seconds (default 300 = 5 min)
NONCE_TTL_SECONDS=300
# Domain string embedded in a wallet challenge. Change per environment to stop
# a signature being replayed across environments.
AUTH_DOMAIN=BRAICE

SOLANA_RPC_URL=https://api.devnet.solana.com
# Blank disables all on-chain writes; the API degrades to no-ops and logs.
SOLANA_PROGRAM_ID=
SOLANA_COMMITMENT=confirmed
# Path to the keypair used to sign on-chain writes.
SOLANA_KEYPAIR_PATH=

# --- AI (optional) ---
# The model is OPTIONAL. With no provider configured, /api/ai/query answers from
# the authorized aggregate and reports answerSource: "deterministic".
#
# AI_PROVIDERS is an ORDERED chain, tried left to right. Providers missing what
# they need are skipped, not fatal, so a deployment with only one key works.
# The legacy single-provider spelling AI_PROVIDER is still honoured.
AI_PROVIDERS=openai,nvidia,ollama

# Primary. Falls through to the next provider if this one fails.
AI_API_KEY=
AI_MODEL=gpt-4
# Point at a compatible gateway instead of OpenAI if you run one.
AI_BASE_URL=

# NVIDIA Build: the same open-weight models, hosted. Free tier, no credit card.
# Key from https://build.nvidia.com/settings
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
# Override to drive a self-hosted NIM on your own GPUs.
NVIDIA_BASE_URL=

# Local Ollama: the same open-weight model on hardware you control, so authorized
# community data never leaves the host.
#
# OLLAMA_MODEL is REQUIRED to enable this tier. Naming `ollama` above without it
# leaves the provider out of the chain entirely, which is deliberate: otherwise a
# shared .env could silently route traffic to a local daemon.
#
# `ollama pull gpt-oss:20b` then `ollama serve` is all this needs.
OLLAMA_MODEL=
# Only set this for a daemon on another host. It is a plain http URL — include
# the scheme, or the API refuses to boot.
OLLAMA_BASE_URL=

AI_TEMPERATURE=0.2
AI_MAX_TOKENS=500

# How long a failed provider is skipped before being tried again. This is what
# keeps a failing provider from costing an extra round trip on EVERY request
# while still recovering on its own. Minimum 1 second; lower values are ignored.
AI_FAILOVER_COOLDOWN_SECONDS=60

FRONTEND_URL=http://localhost:3000
