NODE_ENV=development
# Must match NEXT_PUBLIC_API_URL in ../braice_colosseum_fend/.env.local.
# 3003 is chosen because 3001 is often taken by other local tooling.
PORT=3003

DATABASE_URL=postgresql://braice:braice_secret@localhost:5433/braice_db

# --- Account authentication (email + password) ---
# REQUIRED. Generate with: openssl rand -base64 48
# The API refuses to boot without a >= 32 character value.
JWT_SECRET=
# Access token lifetime in seconds (default 900 = 15 min)
JWT_TTL_SECONDS=900

# Concurrent failed logins before the account is locked.
PASSWORD_MAX_ATTEMPTS=10
# How long the lockout lasts, in seconds (default 900 = 15 min).
PASSWORD_LOCKOUT_SECONDS=900
# scrypt CPU cost as a power of two: 15 => N = 32768 (~32 MB per hash).
# Must be 13..18. Raise it to harden stored passwords; existing hashes are
# re-hashed at the new cost the next time each user signs in.
PASSWORD_SCRYPT_COST=15

# --- Solana ---
# A wallet is an OPTIONAL account attribute used only as the on-chain grantee
# pubkey when a governance grant is anchored. It is never a credential.
#
# Set to true to also allow signing in with a wallet, for accounts that have
# linked one. Off by default: email + password is the product's only real
# sign-in. Unrecognised values (e.g. "yes") are treated as false.
WALLET_AUTH_ENABLED=false
# Sign-in nonce lifetime in seconds (default 300 = 5 min)
NONCE_TTL_SECONDS=300
# Domain string embedded in a wallet challenge. Change per environment to stop
# a signature being replayed across environments.
AUTH_DOMAIN=BRAICE

SOLANA_RPC_URL=https://api.devnet.solana.com
# Blank disables all on-chain writes; the API degrades to no-ops and logs.
SOLANA_PROGRAM_ID=
SOLANA_COMMITMENT=confirmed
# Path to the keypair used to sign on-chain writes.
SOLANA_KEYPAIR_PATH=

AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4

FRONTEND_URL=http://localhost:3000
